# Copy to .env and set your own key. Never commit .env.
OPENAI_API_KEY=your_api_key_here
# Optional: use a model available to your OpenAI project.
OPENAI_MODEL=gpt-5.5

# Oracle RAG database. Run database/01_create_error_knowledge.sql and
# database/02_seed_error_knowledge.sql before configuring these values.
ORACLE_USER=loglens_app
ORACLE_PASSWORD=replace_with_a_password
# Local Oracle AI Database Free container (WORKLOAD_TYPE=ATP).
ORACLE_DSN=localhost:1521/myatp
# Required only for Oracle Autonomous/AI Database wallet connections.
# ORACLE_CONFIG_DIR=C:\\path\\to\\wallet
# ORACLE_WALLET_LOCATION=C:\\path\\to\\wallet
# ORACLE_WALLET_PASSWORD=your_wallet_password

# Optional local Oracle AI Vector Search (semantic RAG) connection.
ORACLE_VECTOR_USER=LOGLENS_VECTOR
ORACLE_VECTOR_PASSWORD=replace_with_vector_user_password
ORACLE_VECTOR_MODEL=ALL_MINILM_L12_V2

# Optional web research. Used only if Oracle RAG returns no match.
TAVILY_API_KEY=your_tavily_api_key_here
